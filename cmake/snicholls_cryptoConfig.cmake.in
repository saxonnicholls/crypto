@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SnichollsCryptoRequire.cmake")

# Crypto is built on core: an installed crypto needs an installed core of at least the version it was built with
include(CMakeFindDependencyMacro)
if(NOT TARGET snicholls::core)
    find_dependency(snicholls_core 0.16)
endif()
snicholls_core_require(0.16.0)

# An installed crypto takes part in the diamond rules exactly like an in-tree one
snicholls_crypto_record_version("@PROJECT_VERSION@" "${CMAKE_CURRENT_LIST_DIR}")
if(NOT TARGET snicholls::crypto)
    include("${CMAKE_CURRENT_LIST_DIR}/snicholls_cryptoTargets.cmake")
    set_property(GLOBAL PROPERTY SNICHOLLS_CRYPTO_VERSION "@PROJECT_VERSION@")
    set_property(GLOBAL PROPERTY SNICHOLLS_CRYPTO_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
endif()

check_required_components(snicholls_crypto)
